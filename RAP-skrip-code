local function refreshAutoPickupFilterText()
    local selected={}

    for _,eggName in ipairs(EggTypes) do
        if eggName~="--" and AutoSelectedEggs[eggName] then
            table.insert(selected,eggName)
        end
    end

    if #selected==0 then
        AutoPickupFilterButton.Text="  -- ▼"
    elseif #selected==1 then
        AutoPickupFilterButton.Text="  "..selected[1].." ▼"
    elseif #selected==2 then
        AutoPickupFilterButton.Text="  "..selected[1]..", "..selected[2].." ▼"
    else
        AutoPickupFilterButton.Text="  "..selected[1]..", "..selected[2]..", +"..tostring(#selected-2).." ▼"
    end

    AutoPickupFilterCount.Text="Selected eggs: "..tostring(#selected)
    AutoPickupFilterButton.BackgroundColor3=#selected>0 and Color3.fromRGB(55,85,60) or Color3.fromRGB(35,35,42)
end

local function createAutoPickupFilterButtons()
    for _,child in ipairs(AutoPickupFilterFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _,eggName in ipairs(EggTypes) do
        local isSelected=eggName~="--" and AutoSelectedEggs[eggName]==true
        local button=Instance.new("TextButton")
        button.Size=UDim2.new(1,-10,0,22)
        button.BackgroundColor3=isSelected and Color3.fromRGB(55,85,60) or Color3.fromRGB(27,27,33)
        button.BackgroundTransparency=isSelected and 0 or 1
        button.TextColor3=isSelected and Color3.fromRGB(225,225,230) or Color3.fromRGB(190,190,198)
        button.TextSize=textSize(10)
        button.Font=Enum.Font.Gotham
        button.TextXAlignment=Enum.TextXAlignment.Left
        button.AutoButtonColor=false
        button.Text=(AutoSelectedEggs[eggName] and "  ☑ " or " ☐ ")..(eggName=="--" and "Clear Selection" or eggName)
        button.Parent=AutoPickupFilterFrame

        button.MouseButton1Click:Connect(function()
            if eggName=="--" then
                AutoSelectedEggs={}
            else
                AutoSelectedEggs[eggName]=not AutoSelectedEggs[eggName] or nil
            end

            createAutoPickupFilterButtons()
            refreshAutoPickupFilterText()
        end)
    end
end
