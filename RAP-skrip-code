RAPSkripFunctions.findMyPlot = function()
    local plots =
        workspace:FindFirstChild("Plots")

    if not plots then
        return nil
    end

    for _, plot in ipairs(plots:GetChildren()) do
        local data =
            plot:FindFirstChild("Data")

        if data then
            local owner =
                data:FindFirstChild("Owner")

            if owner then
                local ownerValue

                pcall(function()
                    ownerValue = owner.Value
                end)

                if ownerValue == player
                    or ownerValue == player.Name
                    or ownerValue == player.DisplayName then

                    return plot
                end

                if tostring(ownerValue) ==
                    tostring(player.Name) then

                    return plot
                end
            end
        end
    end

    return nil
end

