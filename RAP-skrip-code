-- Session monitor refresh; all statistics are temporary and reset on script restart.
task.spawn(function()
    while Gui and Gui.Parent do
        local elapsed = math.max(0, math.floor(os.clock() - SessionStartedAt))
        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = elapsed % 60
        if MonitorRuntimeLabel and MonitorRuntimeLabel.Parent then
            MonitorRuntimeLabel.Text = string.format("Runtime: %02d:%02d:%02d", hours, minutes, seconds)
        end
        if MonitorStatsLabel and MonitorStatsLabel.Parent then
            MonitorStatsLabel.Text = "Hatched: " .. tostring(SessionEggsHatched) .. "  |  Auto Pickup deposits: " .. tostring(SessionEggsDeposited)
        end
        if ProgressRuntimeLabel and ProgressRuntimeLabel.Parent then
            ProgressRuntimeLabel.Text = string.format("Runtime: %02d:%02d:%02d", hours, minutes, seconds)
        end
        if ProgressHatchedLabel and ProgressHatchedLabel.Parent then
            ProgressHatchedLabel.Text = "Eggs hatched: " .. tostring(SessionEggsHatched)
        end
        if ProgressDepositedLabel and ProgressDepositedLabel.Parent then
            ProgressDepositedLabel.Text = "Auto Pickup deposits: " .. tostring(SessionEggsDeposited)
        end
        task.wait(1)
    end
end)
