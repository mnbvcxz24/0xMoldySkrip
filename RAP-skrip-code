RAPSkripFunctions.getAutoHatchPromptPosition = function(prompt)
    if not prompt or not prompt.Parent then
        return nil
    end

    local parent = prompt.Parent
    if parent:IsA("Attachment") then
        return parent.WorldPosition
    end
    if parent:IsA("BasePart") then
        return parent.Position
    end

    local part = parent:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

RAPSkripFunctions.getAutoHatchEggEntries = function(plot)
    if not plot then
        return {}
    end

    local eggsFolder = plot:FindFirstChild("Eggs")
    if not eggsFolder then
        for _, child in ipairs(plot:GetChildren()) do
            if string.lower(child.Name) == "eggs" then
                eggsFolder = child
                break
            end
        end
    end

    return eggsFolder and eggsFolder:GetChildren() or {}
end

RAPSkripFunctions.getAutoHatchPrompt = function(entry)
    if not entry then
        return nil
    end

    if entry:IsA("ProximityPrompt") then
        return entry
    end

    return entry:FindFirstChildWhichIsA("ProximityPrompt", true)
end

RAPSkripFunctions.setAutoHatchStatus = function(status, color)
    if AutoHatchStatus then
        AutoHatchStatus.Text = "● " .. tostring(status)
        AutoHatchStatus.TextColor3 = color or Color3.fromRGB(150, 150, 158)
    end
end

RAPSkripFunctions.isAutoHatchInterrupted = function()
    -- Auto Pickup and Auto Place take priority; Auto Hatch waits and retries afterward.
    return not AutoHatchState.Enabled
        or not Gui.Parent
        or AutoPickupRunning
        or AutoPickupBusy
        or AutoPlaceEnabled
        or AutoPlaceRunning
end

RAPSkripFunctions.tryAutoHatchPrompt = function(entry, prompt)
    if not entry or not entry.Parent or not prompt or not prompt.Parent then
        return false
    end
    if not prompt.Enabled then
        return false
    end

    local root = RAPSkripFunctions.getCharacterRoot()
    if not root then
        return false
    end

    local promptPosition = RAPSkripFunctions.getAutoHatchPromptPosition(prompt)
    if not promptPosition then
        RAPSkripFunctions.AddDebug("[AUTO HATCH] Prompt position unavailable: " .. tostring(entry.Name))
        return false
    end

    local maxDistance = math.max(1, tonumber(prompt.MaxActivationDistance) or 10)
    if (root.Position - promptPosition).Magnitude > math.max(1, maxDistance - 1) then
        if RAPSkripFunctions.isAutoHatchInterrupted() then
            return false
        end
        root.CFrame = CFrame.new(promptPosition + Vector3.new(0, 2.5, 0))
        task.wait(0.25)
        root = RAPSkripFunctions.getCharacterRoot()
        if not root or not prompt.Parent then
            return false
        end
    end

    local ready = prompt:GetAttribute("HatchPromptAvailable")
    if ready == nil then
        ready = entry:GetAttribute("HatchPromptAvailable")
    end
    if ready == nil and prompt.Parent then
        ready = prompt.Parent:GetAttribute("HatchPromptAvailable")
    end

    -- The attribute may be false because the player is out of range, so retry periodically.
    AutoHatchState.Checked[prompt] = { ready = ready, at = os.clock() }
    if ready ~= true then
        return false
    end
    if RAPSkripFunctions.isAutoHatchInterrupted() then
        return false
    end

    local triggered = false
    if typeof(fireproximityprompt) == "function" then
        triggered = pcall(fireproximityprompt, prompt)
    else
        triggered = pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.max(0.1, prompt.HoldDuration))
            prompt:InputHoldEnd()
        end)
    end

    if triggered then
        RAPSkripFunctions.AddDebug("[AUTO HATCH] Hatch attempt: " .. tostring(entry.Name))
        task.wait(0.6)
        return true
    end

    RAPSkripFunctions.AddDebug("[AUTO HATCH] Could not trigger prompt: " .. tostring(entry.Name))
    return false
end

RAPSkripFunctions.autoHatchEggs = function()
    if not AutoHatchState.Enabled or AutoHatchState.Running then
        return
    end
    AutoHatchState.Running = true

    local ok, err = pcall(function()
        RAPSkripFunctions.AddDebug("[AUTO HATCH] Waiting for character control")
        while AutoHatchState.Enabled and Gui.Parent do
            if not RAPSkripFunctions.isAutoHatchInterrupted() then
                break
            end
            RAPSkripFunctions.setAutoHatchStatus("WAITING", Color3.fromRGB(220, 190, 110))
            task.wait(0.25)
        end
        if AutoHatchState.Enabled and Gui.Parent then
            RAPSkripFunctions.setAutoHatchStatus("PROCESSING", Color3.fromRGB(130, 180, 140))
        end
        if not AutoHatchState.Enabled or not Gui.Parent then
            return
        end

        local plot = RAPSkripFunctions.findMyPlot()
        local center = RAPSkripFunctions.getMyRanchCFrame()
        if not plot or not center then
            RAPSkripFunctions.AddDebug("[AUTO HATCH] Your plot or Baseplate was not found")
            return
        end

        local root = RAPSkripFunctions.getCharacterRoot()
        if not root then
            RAPSkripFunctions.AddDebug("[AUTO HATCH] Character root not found")
            return
        end

        AutoHatchState.Busy = true
        root.CFrame = center
        task.wait(0.3)
        RAPSkripFunctions.AddDebug("[AUTO HATCH] Scanning eggs from plot center")

        while AutoHatchState.Enabled and Gui.Parent do
            if AutoPickupRunning or AutoPickupBusy or AutoPlaceEnabled or AutoPlaceRunning then
                RAPSkripFunctions.AddDebug("[AUTO HATCH] Paused for another automation")
                break
            end

            plot = RAPSkripFunctions.findMyPlot()
            if not plot then
                RAPSkripFunctions.AddDebug("[AUTO HATCH] Plot no longer available")
                break
            end

            local entries = RAPSkripFunctions.getAutoHatchEggEntries(plot)
            local sawPrompt = false
            local attemptedHatch = false

            for _, entry in ipairs(entries) do
                if RAPSkripFunctions.isAutoHatchInterrupted() then
                    break
                end

                local prompt = RAPSkripFunctions.getAutoHatchPrompt(entry)
                if prompt then
                    sawPrompt = true
                    local lastCheck = AutoHatchState.Checked[prompt]
                    local currentReady = prompt:GetAttribute("HatchPromptAvailable")
                    if currentReady == nil then
                        currentReady = entry:GetAttribute("HatchPromptAvailable")
                    end

                    local recentlyCheckedNotReady = type(lastCheck) == "table"
                        and lastCheck.ready == false
                        and currentReady == false
                        and os.clock() - (lastCheck.at or 0) < 5

                    if not recentlyCheckedNotReady then
                        if RAPSkripFunctions.tryAutoHatchPrompt(entry, prompt) then
                            attemptedHatch = true
                            task.wait(0.35)
                        end
                    end
                end
            end

            if not AutoHatchState.Enabled or not Gui.Parent then
                break
            end
            if AutoPickupRunning or AutoPickupBusy or AutoPlaceEnabled or AutoPlaceRunning then
                break
            end

            root = RAPSkripFunctions.getCharacterRoot()
            center = RAPSkripFunctions.getMyRanchCFrame()
            if root and center then
                root.CFrame = center
            end

            if not sawPrompt then
                RAPSkripFunctions.AddDebug("[AUTO HATCH] No ProximityPrompt found in plot Eggs folder")
            end
            task.wait(attemptedHatch and 0.5 or 1)
        end
    end)

    AutoHatchState.Busy = false
    AutoHatchState.Running = false

    if not AutoHatchState.Enabled then
        RAPSkripFunctions.setAutoHatchStatus("IDLE", Color3.fromRGB(150, 150, 158))
    elseif AutoPickupRunning or AutoPickupBusy or AutoPlaceEnabled or AutoPlaceRunning then
        RAPSkripFunctions.setAutoHatchStatus("WAITING", Color3.fromRGB(220, 190, 110))
    elseif not ok then
        RAPSkripFunctions.setAutoHatchStatus("ERROR", Color3.fromRGB(220, 100, 100))
        RAPSkripFunctions.AddDebug("[AUTO HATCH] Error: " .. tostring(err))
    end

    -- The old worker exited permanently when Auto Place interrupted it.
    -- Retry while enabled so newly placed eggs are checked after the other task finishes.
    if AutoHatchState.Enabled and Gui.Parent then
        task.delay(0.5, function()
            if AutoHatchState.Enabled and Gui.Parent and not AutoHatchState.Running then
                task.spawn(RAPSkripFunctions.autoHatchEggs)
            end
        end)
    end

    if AutoPlaceEnabled and not AutoPlaceRunning and Gui.Parent then
        task.spawn(RAPSkripFunctions.autoPlaceEggs)
    end
end
