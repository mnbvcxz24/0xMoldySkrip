local function findNextAutoPickupEgg()
    local ActiveEggs =
        getActiveEggs()

    if not ActiveEggs then
        AddDebug(
            "[AUTO ERROR] ActiveEggs not found"
        )

        return nil
    end

    for _, egg in ipairs(
        ActiveEggs:GetChildren()
    ) do

        local eggName =
            egg:GetAttribute("Egg")

        if eggName
            and isAutoPickupEggSelected(eggName) then

            local uuid =
                getEggUUID(egg)
            local position =
                getEggPosition(egg)

            if uuid and position then
                return egg, uuid
            end
        end
    end

    return nil
end

local function waitForPickupConfirmation(uuid)
