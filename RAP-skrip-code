RAPSkripFunctions.getEggPosition = function(egg)
    if not egg then
        return nil
    end

    local position =
        egg:GetAttribute("Position")

    if typeof(position) == "Vector3" then
        return position
    end

    if typeof(position) == "CFrame" then
        return position.Position
    end

    local primaryPart =
        egg:IsA("Model") and egg.PrimaryPart

    if primaryPart then
        return primaryPart.Position
    end

    if egg:IsA("BasePart") then
        return egg.Position
    end

    local part =
        egg:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil
end

RAPSkripFunctions.getEggUUID = function(egg)
    if not egg then
        return nil
    end

    local uuid =
        egg:GetAttribute("UUID")

    if uuid == nil then
        uuid =
            egg:GetAttribute("Uuid")
    end

    if uuid == nil then
        uuid =
            egg:GetAttribute("Id")
    end

    if uuid == nil then
        uuid =
            egg:GetAttribute("ID")
    end

    if uuid == nil then
        uuid = egg.Name
    end

    if typeof(uuid) ~= "string" then
        uuid = tostring(uuid)
    end

    if uuid == "" then
        return nil
    end

    return uuid
end

-- Snapshot inventory egg tools before returning to the plot.
-- EggKey/UUID-like values help distinguish an arriving egg from existing inventory.
local function getInventoryToolKey(tool)
    if not tool then return nil end

    for _, keyName in ipairs({"EggKey", "UUID", "Uuid", "Id", "ID"}) do
        local value = tool:GetAttribute(keyName)
        if value ~= nil and tostring(value) ~= "" then
            return keyName .. ":" .. tostring(value)
        end

        local child = tool:FindFirstChild(keyName)
        if child and child:IsA("ValueBase") and child.Value ~= nil
            and tostring(child.Value) ~= "" then
            return keyName .. ":" .. tostring(child.Value)
        end
    end

    return nil
end

local function getPlayerEggToolSnapshot()
    local snapshot = {instances = {}, keys = {}, counts = {}}
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    local containers = {backpack, character}

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    snapshot.instances[item] = true
                    snapshot.counts[item.Name] = (snapshot.counts[item.Name] or 0) + 1
                    local key = getInventoryToolKey(item)
                    if key then snapshot.keys[key] = true end
                end
            end
        end
    end

    return snapshot
end

local function hasNewInventoryEggTool(eggName, snapshot)
    if not snapshot then return false end

    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    local containers = {backpack, character}

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and item.Name == eggName then
                    local key = getInventoryToolKey(item)
                    if key then
                        if not snapshot.keys[key] then
                            return true
                        end
                    elseif not snapshot.instances[item] then
                        return true
                    end
                end
            end
        end
    end

    return false
end

