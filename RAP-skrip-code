RAPSkripFunctions.getAutoHatchEggEntries = function(plot)
    if not plot then return {} end
    local eggsFolder = plot:FindFirstChild("Eggs")
    if not eggsFolder then
        for _, child in ipairs(plot:GetChildren()) do
            if string.lower(child.Name) == "eggs" then eggsFolder = child break end
        end
    end
    return eggsFolder and eggsFolder:GetChildren() or {}
end

RAPSkripFunctions.getAutoHatchEggKey = function(entry)
    if not entry then return nil end
    local key = entry:GetAttribute("EggKey")
    if type(key) == "string" and key ~= "" then return key end
    local directValue = entry:FindFirstChild("EggKey")
    if directValue and directValue:IsA("ValueBase") then
        local ok, value = pcall(function() return directValue.Value end)
        if ok and type(value) == "string" and value ~= "" then return value end
    end
    for _, descendant in ipairs(entry:GetDescendants()) do
        if descendant.Name == "EggKey" then
            local ok, value = pcall(function()
                if descendant:IsA("ValueBase") then return descendant.Value end
                return descendant:GetAttribute("Value")
            end)
            if ok and type(value) == "string" and value ~= "" then return value end
        end
    end
    return nil
end

RAPSkripFunctions.setAutoHatchStatus = function(status, color)
    if AutoHatchStatus then
        AutoHatchStatus.Text = "● " .. tostring(status)
        AutoHatchStatus.TextColor3 = color or Color3.fromRGB(150, 150, 158)
    end
end

RAPSkripFunctions.isAutoHatchInterrupted = function()
    return not AutoHatchState.Enabled
        or not Gui.Parent
        or AutoPickupBusy
        or AutoPlaceActionBusy
        or not RAPSkripFunctions.isCharacterInMyPlot()
end

RAPSkripFunctions.autoHatchEggs = function()
    if not AutoHatchState.Enabled or AutoHatchState.Running then return end
    AutoHatchState.Running = true
    AutoHatchState.Busy = true
    local ok, err = pcall(function()
        while AutoHatchState.Enabled and Gui.Parent do
            while AutoHatchState.Enabled and Gui.Parent and RAPSkripFunctions.isAutoHatchInterrupted() do
                RAPSkripFunctions.setAutoHatchStatus("WAITING", Color3.fromRGB(220, 190, 110))
                task.wait(0.25)
            end
            if not AutoHatchState.Enabled or not Gui.Parent then break end
            local plot = RAPSkripFunctions.findMyPlot()
            if not plot then
                RAPSkripFunctions.setAutoHatchStatus("WAITING", Color3.fromRGB(220, 190, 110))
                task.wait(1)
            else
                RAPSkripFunctions.setAutoHatchStatus("SCANNING", Color3.fromRGB(130, 180, 140))
                local entries = RAPSkripFunctions.getAutoHatchEggEntries(plot)
                local liveKeys, firedThisCycle = {}, {}
                local sent = 0
                for _, entry in ipairs(entries) do
                    if not AutoHatchState.Enabled or RAPSkripFunctions.isAutoHatchInterrupted() then break end
                    local eggKey = RAPSkripFunctions.getAutoHatchEggKey(entry)
                    if eggKey then
                        liveKeys[eggKey] = true
                        if not firedThisCycle[eggKey] and HatchEvent then
                            firedThisCycle[eggKey] = true
                            RAPSkripFunctions.setAutoHatchStatus("HATCHING", Color3.fromRGB(130, 180, 140))
                            AutoHatchActionBusy = true
                            local fired, fireErr = pcall(function()
                                HatchEvent:FireServer({ EggKey = eggKey })
                            end)
                            AutoHatchActionBusy = false
                            if fired then
                                sent = sent + 1
                                SessionHatchPendingKeys[eggKey] = true
                                RAPSkripFunctions.AddDebug("[AUTO HATCH] Hatch remote fired: " .. tostring(entry.Name))
                            else
                                RAPSkripFunctions.AddDebug("[AUTO HATCH] Remote failed for " .. tostring(entry.Name) .. ": " .. tostring(fireErr))
                            end
                        end
                    else
                        RAPSkripFunctions.AddDebug("[AUTO HATCH] EggKey not found for " .. tostring(entry.Name))
                    end
                    task.wait(0.05)
                end
                for eggKey in pairs(SessionHatchPendingKeys) do
                    if not liveKeys[eggKey] then
                        if not SessionHatchCountedKeys[eggKey] then
                            SessionEggsHatched = SessionEggsHatched + 1
                            SessionHatchCountedKeys[eggKey] = true
                        end
                        SessionHatchPendingKeys[eggKey] = nil
                    end
                end
                RAPSkripFunctions.AddDebug("[AUTO HATCH] Cycle sent " .. tostring(sent) .. " request(s); next refresh in 10 seconds")
                RAPSkripFunctions.setAutoHatchStatus("WAITING 10S", Color3.fromRGB(150, 150, 158))
                local refreshAt = os.clock() + 10
                while AutoHatchState.Enabled and Gui.Parent and os.clock() < refreshAt do
                    if RAPSkripFunctions.isAutoHatchInterrupted() then break end
                    task.wait(0.25)
                end
            end
        end
    end)
    AutoHatchState.Busy = false
    AutoHatchState.Running = false
    if not AutoHatchState.Enabled then
        RAPSkripFunctions.setAutoHatchStatus("IDLE", Color3.fromRGB(150, 150, 158))
    elseif not ok then
        RAPSkripFunctions.setAutoHatchStatus("ERROR", Color3.fromRGB(220, 100, 100))
        RAPSkripFunctions.AddDebug("[AUTO HATCH] Error: " .. tostring(err))
    end
    if AutoHatchState.Enabled and Gui.Parent then
        task.delay(0.5, function()
            if AutoHatchState.Enabled and Gui.Parent and not AutoHatchState.Running then
                task.spawn(RAPSkripFunctions.autoHatchEggs)
            end
        end)
    end
end

