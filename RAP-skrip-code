local function tryAutoPickup(egg)
    if not AutoPickupRunning or AutoPickupBusy then
        return
    end

    if not egg then
        egg=findNextAutoPickupEgg()
    end

    if not egg then
        return
    end

    AutoPickupBusy=true

    local eggName=egg:GetAttribute("Egg")
    local eggPosition=getEggPosition(egg)
    local isVolcanic=eggName=="Volcanic Egg"
    local shouldAutoMagmaDip=AutoMagmaDipEnabled==true

    if not eggName or not eggPosition then
        AutoPickupBusy=false
        return
    end

    AddDebug("[AUTO] Pickup: "..tostring(eggName))

    -- 1. Move to egg
    if isVolcanic then
        if not enterVolcanicEgg(egg) then
            AutoPickupBusy=false
            return
        end
    else
        if not teleportToEgg(egg) then
            AutoPickupBusy=false
            return
        end
    end

    task.wait(AutoPickupClaimDelay)

    -- 2. Get pickup UUID
    local pickupUUID=getEggUUID(egg)

    if not pickupUUID then
        AddDebug("[AUTO ERROR] Pickup UUID not found")
        AutoPickupBusy=false
        return
    end

    -- 3. Pick up original egg
    AutoPickupStage="InitialPickup"
    AutoPickupAwaitingUUID=tostring(pickupUUID)
    AutoPickupAwaitingPickup=true
    AutoPickupPickupConfirmed=false

    EggPickupEvent:FireServer(tostring(pickupUUID))

    local pickupStart=os.clock()

    while AutoPickupRunning and not AutoPickupPickupConfirmed and os.clock()-pickupStart<5 do
        task.wait(0.1)
    end

    AutoPickupAwaitingPickup=false

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    if not AutoPickupPickupConfirmed then
        AddDebug("[AUTO ERROR] Initial pickup not confirmed")
        AutoPickupAwaitingUUID=nil
        AutoPickupBusy=false
        return
    end

    AutoPickupAwaitingUUID=nil
    AutoPickupPickupConfirmed=false
    stopAutoPickupFloat()

    -- 4. Auto Magma Dip
    if shouldAutoMagmaDip then
        local root=getCharacterRoot()

        if root then
            root.CFrame=CFrame.new(VolcanoDropPosition)
        else
            AddDebug("[AUTO MAGMA DIP ERROR] Root not found")
            AutoPickupBusy=false
            return
        end

        task.wait(1)

        AutoMagmaDipResult=nil
        AutoMagmaDipWaitingForResult=true
        AutoVolcanoMessageReceived=false
        AutoVolcanoMessageReceived=false
        AutoVolcanoMessageText=nil
        AutoVolcanoMessageType=nil
        AutoVolcanoWaitingForMessage=true

        if VolcanoDipEvent then
            VolcanoDipEvent:FireServer()
        else
            AddDebug("[AUTO MAGMA DIP ERROR] VolcanoDip remote missing")
            AutoMagmaDipWaitingForResult=false
            AutoVolcanoWaitingForMessage=false
            AutoPickupBusy=false
            return
        end

        local resultStart=os.clock()

        while AutoPickupRunning and AutoMagmaDipWaitingForResult and os.clock()-resultStart<10 do
            task.wait(0.1)
        end

        AutoMagmaDipWaitingForResult=false

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        if AutoMagmaDipResult==nil then
            AddDebug("[AUTO MAGMA DIP] Result timeout")
            AutoVolcanoWaitingForMessage=false
            AutoPickupBusy=false
            return
        end

        local messageStart=os.clock()

        while AutoPickupRunning and AutoVolcanoWaitingForMessage and os.clock()-messageStart<10 do
            task.wait(0.1)
        end

        AutoVolcanoWaitingForMessage=false

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        if not AutoVolcanoMessageReceived then
            AddDebug("[AUTO MAGMA DIP] Mutation message timeout")
            AutoPickupBusy=false
            return
        end

        AddDebug("[AUTO MAGMA DIP] Mutation: "..tostring(AutoVolcanoMessageText))
        stopAutoPickupFloat()

        -- Use volcano position for the post-dip outside position
        local reachedOutside=false

        while AutoPickupRunning and not reachedOutside do
            if teleportOutsidePlot(VolcanoDropPosition) then
                reachedOutside=true
            else
                task.wait(0.1)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        task.wait(1)

    -- 5. Volcanic Egg without Magma Dip
    elseif isVolcanic then
        exitVolcanicEgg()
        stopAutoPickupFloat()

        -- Refresh the current egg position
        local currentEggPosition=getEggPosition(egg) or eggPosition
        local reachedOutside=false

        while AutoPickupRunning and not reachedOutside do
            if teleportOutsidePlot(currentEggPosition) then
                reachedOutside=true
            else
                task.wait(0.25)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        task.wait(1)

    -- 6. Normal Egg without Magma Dip
    else
        stopAutoPickupFloat()

        -- Refresh the current egg position
        local currentEggPosition=getEggPosition(egg) or eggPosition
        local reachedOutside=false

        while AutoPickupRunning and not reachedOutside do
            if teleportOutsidePlot(currentEggPosition) then
                reachedOutside=true
            else
                task.wait(0.1)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        task.wait(1)
    end

    -- 7. Prepare dropped egg detection
    local BasketDropEvent=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Game"):WaitForChild("BasketDrop")
    local previousDroppedUUIDs={}
    local activeEggsBeforeDrop=getActiveEggs()

    if activeEggsBeforeDrop then
        for _,existingEgg in ipairs(activeEggsBeforeDrop:GetChildren()) do
            local existingUUID=getEggUUID(existingEgg)

            if existingUUID then
                previousDroppedUUIDs[tostring(existingUUID)]=true
            end
        end
    end

    local root=getCharacterRoot()
    local dropPosition=root and root.Position

    if not dropPosition then
        AddDebug("[AUTO ERROR] Drop position unavailable")
        AutoPickupBusy=false
        return
    end

    -- 8. Drop egg
    AutoPickupStage="Drop"

    BasketDropEvent:FireServer()

    task.wait(0.25)

    -- 9. Find newly dropped egg
    local droppedEgg=nil
    local dropStart=os.clock()

    while AutoPickupRunning and not droppedEgg and os.clock()-dropStart<5 do
        droppedEgg=waitForDroppedEgg(eggName,previousDroppedUUIDs,dropPosition,0.5)

        if not droppedEgg then
            task.wait(0.1)
        end
    end

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    if not droppedEgg then
        AutoPickupBusy=false
        return
    end

    local droppedUUID=droppedEgg.UUID
    
    if not droppedUUID then
        AddDebug("[AUTO ERROR] Dropped egg UUID not found")
        AutoPickupBusy=false
        return
    end
    
    droppedUUID=tostring(droppedUUID)

    -- 10. Pick up dropped egg
    AutoPickupStage="DroppedPickup"
    AutoPickupAwaitingUUID=droppedUUID
    AutoPickupAwaitingPickup=true
    AutoPickupPickupConfirmed=false

    EggPickupEvent:FireServer(droppedUUID)

    local droppedPickupStart=os.clock()

    while AutoPickupRunning and not AutoPickupPickupConfirmed and os.clock()-droppedPickupStart<5 do
        task.wait(0.1)
    end

    AutoPickupAwaitingPickup=false

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    if not AutoPickupPickupConfirmed then
        AddDebug("[AUTO ERROR] Dropped pickup not confirmed")
        AutoPickupAwaitingUUID=nil
        AutoPickupBusy=false
        return
    end

    AutoPickupAwaitingUUID=nil
    AutoPickupPickupConfirmed=false

    -- 11. Return to plot
    AutoPickupStage="GoingToPlot"

    local reachedPlot=false

    while AutoPickupRunning and not reachedPlot do
        if teleportToMyPlot() then
            reachedPlot=true
        else
            task.wait(0.1)
        end
    end

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    task.wait(1)

    -- 12. Deposit egg
    AutoPickupStage="Deposit"
    AutoPickupAwaitingDeposit=true
    AutoPickupDepositConfirmed=false

    local ranchCFrame=getMyRanchCFrame()

    if not ranchCFrame then
        AddDebug("[AUTO ERROR] Ranch CFrame not found")
        AutoPickupAwaitingDeposit=false
        AutoPickupBusy=false
        return
    end

    local arrivalPosition=ranchCFrame.Position
    local serverTime=workspace:GetServerTimeNow()

    if EggArrivalClaimEvent then
        EggArrivalClaimEvent:FireServer(serverTime,arrivalPosition,{droppedUUID})
    else
        AddDebug("[AUTO ERROR] Arrival claim remote missing")
        AutoPickupAwaitingDeposit=false
        AutoPickupBusy=false
        return
    end

    local depositStart=os.clock()

    while AutoPickupRunning and not AutoPickupDepositConfirmed and os.clock()-depositStart<5 do
        task.wait(0.1)
    end

    AutoPickupAwaitingDeposit=false

    if AutoPickupDepositConfirmed then
        AddDebug("[AUTO] Egg deposited successfully")
    else
        AddDebug("[AUTO ERROR] Deposit not confirmed")
    end

    AutoPickupDepositConfirmed=false
    AutoPickupStage="Idle"
    AutoPickupBusy=false
end
