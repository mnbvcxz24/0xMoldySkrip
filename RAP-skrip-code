            AddDebug("Selected: "..table.concat(selectedNames,", "))
        end
        local counts={}
        for _,egg in ipairs(eggs) do
            local eggName=egg:GetAttribute("Egg")
            if eggName and eggName~="" then
                counts[eggName]=(counts[eggName] or 0)+1
            end
        end
        for eggName,count in pairs(counts) do
            AddDebug(tostring(eggName).." x "..tostring(count))
        end
        for _,selectedName in ipairs(selectedNames) do
            local selectedWeight
            for _,egg in ipairs(eggs) do
                if egg:GetAttribute("Egg")==selectedName then
                    selectedWeight=tonumber(egg:GetAttribute("Weight"))
                    break
                end
            end
            AddDebug("Egg: "..tostring(selectedName))
            AddDebug("Weight: "..tostring(selectedWeight))
            AddDebug("Selected Count: "..tostring(counts[selectedName] or 0))
        end
        AddDebug("Total Active Eggs: "..tostring(#eggs))
        for _,egg in ipairs(eggs) do
            local eggName=egg:GetAttribute("Egg")
            if eggName and SelectedEggs[eggName] then
                local position=egg:GetAttribute("Position")
                AddDebug(tostring(eggName).." | Position Type: "..typeof(position))
            end
        end
        AddDebug("========== SCAN COMPLETE ==========")
    end)
