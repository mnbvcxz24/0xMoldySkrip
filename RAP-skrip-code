-- Smoothly glide from the current position to the player's own plot center.
-- The existing outside-plot teleport still runs after this glide.
RAPSkripFunctions.glideToMyPlot = function()
    local root = RAPSkripFunctions.getCharacterRoot()
    local targetCFrame = RAPSkripFunctions.getMyRanchCFrame()

    if not root or not targetCFrame then
        RAPSkripFunctions.AddDebug("[AUTO MOVE] Cannot glide: character root or plot not found")
        return false
    end

    -- Glide only halfway toward the plot. The caller then teleports to the
    -- outside-drop position, preserving the drop/pickup/return sequence.
    local startCFrame = root.CFrame
    local halfwayCFrame = startCFrame:Lerp(targetCFrame, 0.5)
    local distance = (halfwayCFrame.Position - startCFrame.Position).Magnitude
    local glideSpeed = 500 -- studs per second
    local duration = distance / glideSpeed
    local stepInterval = 0.05
    local steps = math.max(1, math.ceil(duration / stepInterval))

    for step = 1, steps do
        if not AutoPickupRunning then
            return false
        end

        local alpha = step / steps
        local ok = pcall(function()
            root.CFrame = startCFrame:Lerp(halfwayCFrame, alpha)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)

        if not ok then
            return false
        end

        task.wait(duration / steps)
    end

    return true
end

RAPSkripFunctions.teleportOutsidePlot = function(eggPosition)
    local root = RAPSkripFunctions.getCharacterRoot()

    if not root then
        return false
    end

    local plot = RAPSkripFunctions.findMyPlot()

    if not plot or not eggPosition then
        return false
    end

    local baseplate = plot:FindFirstChild("Baseplate")

    if not baseplate or not baseplate:IsA("BasePart") then
        return false
    end

    local center =
        baseplate.Position +
        Vector3.new(
            0,
            baseplate.Size.Y / 2 + 3,
            0
        )

    local direction =
        Vector3.new(
            eggPosition.X - center.X,
            0,
            eggPosition.Z - center.Z
        )

    if direction.Magnitude == 0 then
        return false
    end

    direction = direction.Unit

    local edge =
        (math.abs(
            direction:Dot(
                baseplate.CFrame.RightVector
            )
        ) * baseplate.Size.X / 2) +
        (math.abs(
            direction:Dot(
                baseplate.CFrame.LookVector
            )
        ) * baseplate.Size.Z / 2)

    local outsidePosition =
        center +
        direction *
        (edge + 10)

    local success = pcall(function()
        root.CFrame =
            CFrame.new(
                outsidePosition
            )
    end)

    if not success then
        return false
    end

    return true
end
