RAPSkripFunctions.tryAutoPickup = function(egg)
    if not AutoPickupRunning or AutoPickupBusy then return end
    if not egg then egg=findNextAutoPickupEgg() end
    if not egg then return end

    AutoPickupBusy=true

    local eggName=egg:GetAttribute("Egg")
    local eggPosition=RAPSkripFunctions.getEggPosition(egg)
    local isVolcanic=eggName=="Volcanic Egg"
    local shouldAutoMagmaDip=AutoMagmaDipEnabled==true

    if not eggName or not eggPosition then
        AutoPickupBusy=false
        return
    end

    RAPSkripFunctions.AddDebug("[AUTO] Pickup: "..tostring(eggName))

    -- 1. Move to egg
    if isVolcanic then
        if not RAPSkripFunctions.enterVolcanicEgg(egg) then
            AutoPickupBusy=false
            return
        end
    elseif not RAPSkripFunctions.teleportToEgg(egg) then
        AutoPickupBusy=false
        return
    end

    task.wait(AutoPickupClaimDelay)

    -- 2. Get pickup UUID
    local pickupUUID=RAPSkripFunctions.getEggUUID(egg)
    if not pickupUUID then
        RAPSkripFunctions.AddDebug("[AUTO ERROR] Pickup UUID not found")
        AutoPickupBusy=false
        return
    end

    -- 3. Pick up original egg
    AutoPickupStage="InitialPickup"
    AutoPickupAwaitingUUID=tostring(pickupUUID)
    AutoPickupAwaitingPickup=true
    AutoPickupPickupConfirmed=false
    EggPickupEvent:FireServer(tostring(pickupUUID))

    local pickupStart=os.clock()
    while AutoPickupRunning and not AutoPickupPickupConfirmed and os.clock()-pickupStart<5 do
        task.wait(0.1)
    end

    AutoPickupAwaitingPickup=false

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    if not AutoPickupPickupConfirmed then
        RAPSkripFunctions.AddDebug("[AUTO ERROR] Initial pickup not confirmed")
        AutoPickupAwaitingUUID=nil
        AutoPickupBusy=false
        return
    end

    AutoPickupAwaitingUUID=nil
    AutoPickupPickupConfirmed=false

    -- 4. Auto Magma Dip
    if shouldAutoMagmaDip then
        local root=RAPSkripFunctions.getCharacterRoot()
        if not root then
            RAPSkripFunctions.AddDebug("[AUTO MAGMA DIP ERROR] Root not found")
            AutoPickupBusy=false
            return
        end

        if isVolcanic then
            if not RAPSkripFunctions.exitVolcanicEgg() then
                AutoPickupBusy=false
                return
            end
        end

        root.CFrame=CFrame.new(VolcanoDropPosition)
        task.wait(1)

        AutoMagmaDipResult=nil
        AutoMagmaDipWaitingForResult=true
        AutoVolcanoMessageReceived=false
        AutoVolcanoMessageText=nil
        AutoVolcanoMessageType=nil
        AutoVolcanoWaitingForMessage=true

        if not VolcanoDipEvent or not VolcanoDipEvent:IsA("RemoteEvent") then
            RAPSkripFunctions.AddDebug("[AUTO MAGMA DIP ERROR] VolcanoDip remote missing or invalid")
            AutoMagmaDipWaitingForResult=false
            AutoVolcanoWaitingForMessage=false
            AutoPickupBusy=false
            return
        end

        local dipRequestOk, dipRequestError = pcall(function()
            VolcanoDipEvent:FireServer()
        end)

        if not dipRequestOk then
            RAPSkripFunctions.AddDebug("[AUTO MAGMA DIP ERROR] Request failed: " .. tostring(dipRequestError))
            AutoMagmaDipWaitingForResult=false
            AutoVolcanoWaitingForMessage=false
            AutoPickupBusy=false
            return
        end

        -- 5. Wait for either result OR mutation message
        local dipStart=os.clock()
        while AutoPickupRunning and os.clock()-dipStart<10 do
            if AutoVolcanoMessageReceived then
                break
            end
            if AutoMagmaDipResult~=nil then
                break
            end
            task.wait(0.1)
        end

        AutoMagmaDipWaitingForResult=false

        if not AutoPickupRunning then
            AutoVolcanoWaitingForMessage=false
            AutoPickupBusy=false
            return
        end

        -- 6. Handle the response
        if AutoVolcanoMessageReceived then
            if AutoVolcanoMessageType=="Failed" then
            elseif AutoVolcanoMessageType=="Success" then
            else
            end
        elseif AutoMagmaDipResult~=nil then

            -- A result was received, now give the mutation message
            -- time to arrive if it is sent separately.
            local messageStart=os.clock()
            while AutoPickupRunning and not AutoVolcanoMessageReceived and os.clock()-messageStart<12 do
                task.wait(5)
            end

            if AutoVolcanoMessageReceived then
                if AutoVolcanoMessageType=="Failed" then
                elseif AutoVolcanoMessageType=="Success" then
                else
                end
            else
            end
        else
            RAPSkripFunctions.AddDebug("[AUTO MAGMA DIP] No result/message received")
        end

        AutoVolcanoWaitingForMessage=false

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end
        -- 7. Glide back to the player's plot, then use the existing outside-plot teleport.
        if not RAPSkripFunctions.glideToMyPlot() then
            AutoPickupBusy=false
            return
        end

        local reachedOutside=false
        while AutoPickupRunning and not reachedOutside do
            if RAPSkripFunctions.teleportOutsidePlot(VolcanoDropPosition) then
                reachedOutside=true
            else
                task.wait(0.1)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        -- Allow the outside-plot position to settle before dropping.
        task.wait(0.75)

    -- 8. Volcanic Egg without Magma Dip
    elseif isVolcanic then
        RAPSkripFunctions.exitVolcanicEgg()

        local currentEggPosition=RAPSkripFunctions.getEggPosition(egg) or eggPosition
        if not RAPSkripFunctions.glideToMyPlot() then
            AutoPickupBusy=false
            return
        end

        local reachedOutside=false

        while AutoPickupRunning and not reachedOutside do
            if RAPSkripFunctions.teleportOutsidePlot(VolcanoDropPosition) then
                reachedOutside=true
            else
                task.wait(0.25)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        -- Allow the outside-plot position to settle before dropping.
        task.wait(0.75)

    -- 9. Normal Egg without Magma Dip
    else
        local currentEggPosition=RAPSkripFunctions.getEggPosition(egg) or eggPosition
        if not RAPSkripFunctions.glideToMyPlot() then
            AutoPickupBusy=false
            return
        end

        local reachedOutside=false

        while AutoPickupRunning and not reachedOutside do
            if RAPSkripFunctions.teleportOutsidePlot(currentEggPosition) then
                reachedOutside=true
            else
                task.wait(0.1)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        -- Allow the outside-plot position to settle before dropping.
        task.wait(0.75)
    end

    -- 10. Prepare dropped egg detection
    local BasketDropEvent=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Game"):WaitForChild("BasketDrop")
    local previousDroppedUUIDs={}
    local activeEggsBeforeDrop=RAPSkripFunctions.getActiveEggs()

    if activeEggsBeforeDrop then
        for _,existingEgg in ipairs(activeEggsBeforeDrop:GetChildren()) do
            local existingUUID=RAPSkripFunctions.getEggUUID(existingEgg)
            if existingUUID then
                previousDroppedUUIDs[tostring(existingUUID)]=true
            end
        end
    end

    local root=RAPSkripFunctions.getCharacterRoot()
    local dropPosition=root and root.Position

    if not dropPosition then
        RAPSkripFunctions.AddDebug("[AUTO ERROR] Drop position unavailable")
        AutoPickupBusy=false
        return
    end

    -- 11. Drop egg
    task.wait(0.5) -- Brief pause before sending the drop request.
    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    AutoPickupStage="Drop"
    BasketDropEvent:FireServer()
    RAPSkripFunctions.stopAutoPickupFloat()
    task.wait(0.75) -- Give the dropped egg time to appear in ActiveEggs.

    -- 12. Find newly dropped egg
    local droppedEgg
    local dropStart=os.clock()

    while AutoPickupRunning and not droppedEgg and os.clock()-dropStart<5 do
        droppedEgg=waitForDroppedEgg(eggName,previousDroppedUUIDs,dropPosition,0.5)
        if not droppedEgg then
            task.wait(0.1)
        end
    end

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    if not droppedEgg then
        RAPSkripFunctions.AddDebug("[AUTO ERROR] Dropped egg not found")
        AutoPickupBusy=false
        return
    end

    local droppedUUID=droppedEgg.UUID
    if not droppedUUID then
        RAPSkripFunctions.AddDebug("[AUTO ERROR] Dropped egg UUID not found")
        AutoPickupBusy=false
        return
    end

    droppedUUID=tostring(droppedUUID)

    -- 13. Pick up dropped egg
    AutoPickupStage="DroppedPickup"
    AutoPickupAwaitingUUID=droppedUUID
    AutoPickupAwaitingPickup=true
    AutoPickupPickupConfirmed=false
    EggPickupEvent:FireServer(droppedUUID)

    local droppedPickupStart=os.clock()
    while AutoPickupRunning and not AutoPickupPickupConfirmed and os.clock()-droppedPickupStart<5 do
        task.wait(0.1)
    end

    AutoPickupAwaitingPickup=false

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    if not AutoPickupPickupConfirmed then
        RAPSkripFunctions.AddDebug("[AUTO ERROR] Dropped pickup not confirmed")
        AutoPickupAwaitingUUID=nil
        AutoPickupBusy=false
        return
    end

    AutoPickupAwaitingUUID=nil
    AutoPickupPickupConfirmed=false

    task.wait(0.5) -- Let the dropped pickup settle before returning to the plot.
    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    -- 14. Return to plot
    AutoPickupStage="GoingToPlot"
    local reachedPlot=false

    while AutoPickupRunning and not reachedPlot do
        if RAPSkripFunctions.teleportToMyPlot() then
            reachedPlot=true
        else
            task.wait(0.1)
        end
    end

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    task.wait(1)

    -- 15. Deposit egg
    AutoPickupStage="Deposit"
    AutoPickupAwaitingDeposit=true
    AutoPickupDepositConfirmed=false

    local ranchCFrame=RAPSkripFunctions.getMyRanchCFrame()
    if not ranchCFrame then
        RAPSkripFunctions.AddDebug("[AUTO ERROR] Ranch CFrame not found")
        AutoPickupAwaitingDeposit=false
        AutoPickupBusy=false
