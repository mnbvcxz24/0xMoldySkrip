            AddDebug("[ERROR] ActiveEggs not found")
            return
        end
        local eggs=ActiveEggs:GetChildren()
        EggCount.Text="Active Eggs: "..tostring(#eggs)
        local selectedNames=getSelectedEggNames()
        if #selectedNames==0 then
            AddDebug("No egg selected")
