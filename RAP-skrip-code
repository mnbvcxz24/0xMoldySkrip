local DebugLines={}

local DebugText
local DebugBox

RAPSkripFunctions.AddDebug = function(message)
    table.insert(DebugLines,tostring(message))

    if #DebugLines>50 then
        table.remove(DebugLines,1)
    end

    if DebugText then
        DebugText.Text=table.concat(DebugLines,"\n")
    end

    if DebugText and DebugBox then
        task.defer(function()
            if DebugText and DebugBox then
                DebugBox.CanvasSize=UDim2.fromOffset(0,DebugText.AbsoluteSize.Y+15)
                DebugBox.CanvasPosition=Vector2.new(
                    0,
                    math.max(0,DebugText.AbsoluteSize.Y-DebugBox.AbsoluteSize.Y)
                )
            end
        end)
    end
end
