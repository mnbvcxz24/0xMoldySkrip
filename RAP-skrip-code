task.spawn(function()
    while Gui.Parent do
        -- Auto Pickup has priority; Auto Hatch already pauses itself while a pickup is busy.
        if AutoPickupRunning and not AutoPickupBusy and not AutoPlaceActionBusy and not AutoHatchActionBusy then
            local success,err=xpcall(function()
                RAPSkripFunctions.tryAutoPickup()
            end,function(errorMessage)
                return debug.traceback(tostring(errorMessage),2)
            end)

            if not success then
                warn("[AUTO ERROR]\n"..tostring(err))
                AutoPickupBusy=false
                task.wait(1)
            end
        end

        task.wait(0.25)
    end
end)
