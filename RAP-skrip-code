local function applyColorTheme(themeName)
    local palette = ThemePalette[themeName] or ThemePalette.Midnight
    SelectedColorTheme = ThemePalette[themeName] and themeName or "Midnight"
    for _, object in ipairs(Gui:GetDescendants()) do
        if object:IsA("GuiObject") then
            local bg = object.BackgroundColor3
            if object.BackgroundTransparency < 1 then
                if object == Main or object == Content or object == Content1 or object == Content2 then
                    object.BackgroundColor3 = palette.bg
                elseif object:IsA("Frame") and (bg.R < 0.22 and bg.G < 0.22 and bg.B < 0.25) then
                    object.BackgroundColor3 = palette.panel
                elseif bg.R < 0.3 and bg.G < 0.3 and bg.B < 0.35 then
                    object.BackgroundColor3 = palette.card
                end
            end
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                local tc = object.TextColor3
                if tc.R > 0.68 and tc.G > 0.68 and tc.B > 0.68 then
                    object.TextColor3 = palette.text
                elseif tc.R > 0.48 and tc.G > 0.48 and tc.B > 0.48 and tc.R < 0.82 then
                    object.TextColor3 = palette.muted
                end
            end
            if object:IsA("TextButton") and (string.find(object.Name, "Theme_") or string.find(object.Name, "Toggle")) then
                object.BackgroundColor3 = palette.accent
            end
        end
    end
    for name, button in pairs(ThemeButtons) do
        local selected = name == SelectedColorTheme
        button.BackgroundColor3 = selected and palette.accent or palette.card
        button.TextColor3 = palette.text
    end
end
for themeName, themeButton in pairs(ThemeButtons) do
    themeButton.MouseButton1Click:Connect(function()
        applyColorTheme(themeName)
        RAPSkripFunctions.saveConfig()
    end)
end

