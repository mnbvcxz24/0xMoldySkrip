local function getActiveEggs()
    local ServerData =
        ReplicatedStorage:FindFirstChild("ServerData")

    if not ServerData then
        return nil
    end

    return ServerData:FindFirstChild("ActiveEggs")
end

local function getEggPosition(egg)
    if not egg then
        return nil
    end

    local position =
        egg:GetAttribute("Position")

    if typeof(position) == "Vector3" then
        return position
    end

    if typeof(position) == "CFrame" then
        return position.Position
    end

    local primaryPart =
        egg:IsA("Model") and egg.PrimaryPart

    if primaryPart then
        return primaryPart.Position
    end

    if egg:IsA("BasePart") then
        return egg.Position
    end

    local part =
        egg:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil
end

local function getEggUUID(egg)
    if not egg then
        return nil
    end

    local uuid =
        egg:GetAttribute("UUID")

    if uuid == nil then
        uuid =
            egg:GetAttribute("Uuid")
    end

    if uuid == nil then
        uuid =
            egg:GetAttribute("Id")
    end

    if uuid == nil then
        uuid =
            egg:GetAttribute("ID")
    end

    if uuid == nil then
        uuid = egg.Name
    end

    if typeof(uuid) ~= "string" then
        uuid = tostring(uuid)
    end

    if uuid == "" then
        return nil
    end

    return uuid
end

local function isAutoPickupEggSelected(eggName)
    return AutoSelectedEggs[eggName] == true
end

local function getCharacterRoot()
    local character =
        player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

local function startAutoPickupFloat(position)
    local character = player.Character

    if not character then
        return false
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return false
    end

    local attachment =
        root:FindFirstChild(
            "AutoPickupFloatAttachment"
        )

    if not attachment then
        attachment =
            Instance.new("Attachment")

        attachment.Name =
            "AutoPickupFloatAttachment"

        attachment.Parent = root
    end

    local force =
        root:FindFirstChild(
            "AutoPickupFloatForce"
        )

    if not force then
        force =
            Instance.new("VectorForce")

        force.Name =
            "AutoPickupFloatForce"

        force.Attachment0 =
            attachment

        force.RelativeTo =
            Enum.ActuatorRelativeTo.World

        force.ApplyAtCenterOfMass =
            true

        force.Parent = root
    end

    AutoPickupFloating = true
    AutoPickupFloatForce = force

    root.CFrame =
        CFrame.new(
            position +
            Vector3.new(
                0,
                AutoPickupFloatHeight,
                0
            )
        )

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    force.Force =
        Vector3.new(
            0,
            root.AssemblyMass *
                workspace.Gravity,
            0
        )

    return true
end

local function stopAutoPickupFloat()
    AutoPickupFloating = false

    local force =
        AutoPickupFloatForce

    AutoPickupFloatForce = nil

    if force then
        pcall(function()
            force:Destroy()
        end)
    end

    local character =
        player.Character

    if not character then
        return
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local attachment =
        root:FindFirstChild(
            "AutoPickupFloatAttachment"
        )

    if attachment then
        pcall(function()
            attachment:Destroy()
        end)
    end

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero
end

