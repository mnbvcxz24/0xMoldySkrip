local ESPFolder=Instance.new("Folder")
ESPFolder.Name="EggESP"
ESPFolder.Parent=workspace

local ESPObjects={}

local function clearESP()
    for egg, data in pairs(ESPObjects) do
        if data and data.Part then
            pcall(function()
                data.Part:Destroy()
            end)
        end

        ESPObjects[egg]=nil
    end
end

local function createESP(egg)
    if ESPObjects[egg] then
        return
    end

    local eggName=egg:GetAttribute("Egg") or "Egg"
    local position=getEggPosition(egg)

    if not position then
        AddDebug("[ESP ERROR] No usable Position: "..tostring(eggName))
        return
    end

    local part=Instance.new("Part")
    part.Name="EggESP_"..tostring(egg.Name)
    part.Size=Vector3.new(0.5,0.5,0.5)
    part.Position=position
    part.Anchored=true
    part.CanCollide=false
    part.CanTouch=false
    part.CanQuery=false
    part.Transparency=1
    part.Parent=ESPFolder

    local billboard=Instance.new("BillboardGui")
    billboard.Name="EggLabel"
    billboard.Size=UDim2.fromOffset(180,45)
    billboard.StudsOffset=Vector3.new(0,3,0)
    billboard.AlwaysOnTop=true
    billboard.MaxDistance=math.huge
    billboard.Parent=part

    local label=Instance.new("TextLabel")
    label.Size=UDim2.fromScale(1,1)
    label.BackgroundTransparency=1
    label.Text=eggName
    label.TextColor3=Color3.fromRGB(255,255,255)
    label.TextStrokeTransparency=0
    label.TextStrokeColor3=Color3.fromRGB(0,0,0)
    label.TextSize=textSize(13)
    label.Font=Enum.Font.GothamBold
    label.Parent=billboard

    ESPObjects[egg]={
        Part=part,
        Label=label
    }
end

function updateESP()
    if Toggle.Text~="ON" then
        clearESP()
        return
    end

    local selectedNames=getSelectedEggNames()

    if #selectedNames==0 then
        clearESP()
        FilterCount.Text="Detected eggs: 0"
        updateDetectedEggList({})
        return
    end

    local ActiveEggs=getActiveEggs()

    if not ActiveEggs then
        clearESP()
        AddDebug("[ESP ERROR] ActiveEggs not found")
        FilterCount.Text="Detected eggs: 0"
        updateDetectedEggList({})
        return
    end

    local eggs=ActiveEggs:GetChildren()
    local activeEggSet={}
    local detectedLines={}
    local totalSelected=0

    for _, egg in ipairs(eggs) do
        local currentEggName=egg:GetAttribute("Egg")

        if currentEggName and SelectedEggs[currentEggName] then
            totalSelected=totalSelected+1

            local weight=tonumber(egg:GetAttribute("Weight"))
            local position=getEggPosition(egg)

            if not ESPObjects[egg] then
                createESP(egg)
            end

            if ESPObjects[egg] then
                local data=ESPObjects[egg]

                if position and data.Part then
                    data.Part.Position=position
                end

                if data.Label then
                    local weightText="--"

                    if weight~=nil then
                        weightText=string.format("%.2f",weight)
                    end

                    data.Label.Text=tostring(currentEggName).." | "..weightText
                end
            end

            activeEggSet[egg]=true

            local weightText="--"

            if weight~=nil then
                weightText=string.format("%.2f",weight)
            end

            table.insert(
                detectedLines,
                tostring(currentEggName).." - "..weightText
            )
        end
    end

    for egg, data in pairs(ESPObjects) do
        if not activeEggSet[egg] then
            if data and data.Part then
                pcall(function()
                    data.Part:Destroy()
                end)
            end

            ESPObjects[egg]=nil
        end
    end

    EggCount.Text="Active Eggs: "..tostring(#eggs)
    FilterCount.Text="Detected eggs: "..tostring(totalSelected)
    updateDetectedEggList(detectedLines)
end

