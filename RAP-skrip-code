            if AutoPickupStage=="InitialPickup"
                and AutoPickupAwaitingPickup
                and AutoPickupAwaitingUUID
                and tostring(uuid)==tostring(AutoPickupAwaitingUUID) then

                AutoPickupPickupConfirmed=true
                AutoPickupAwaitingPickup=false

            elseif AutoPickupStage=="DroppedPickup"
                and AutoPickupAwaitingPickup
                and AutoPickupAwaitingUUID
                and tostring(uuid)==tostring(AutoPickupAwaitingUUID) then

                AutoPickupPickupConfirmed=true
                AutoPickupAwaitingPickup=false
            end

        elseif action=="Deposited" then

            if AutoPickupStage=="Deposit"
                and AutoPickupAwaitingDeposit then

                AutoPickupDepositConfirmed=true
                AutoPickupAwaitingDeposit=false
            end
        end
    end)
else
    RAPSkripFunctions.AddDebug("[AUTO ERROR] EggPickup remote not found")
end

