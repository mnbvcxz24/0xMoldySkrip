local function getDroppedEggData(uuid)
    local ActiveEggs = getActiveEggs()

    if not ActiveEggs then
        AddDebug("[AUTO ERROR] ActiveEggs not found")
        return nil
    end

    for _, egg in ipairs(ActiveEggs:GetChildren()) do
        local eggUUID = getEggUUID(egg)

        if eggUUID and tostring(eggUUID) == tostring(uuid) then
            local eggName = egg:GetAttribute("Egg")
            local breakRemaining = egg:GetAttribute("BreakRemaining")
            local dropStartedAt = egg:GetAttribute("DropStartedAt")

            if breakRemaining ~= nil then
                return {
                    Instance = egg,
                    UUID = tostring(eggUUID),
                    Egg = eggName,
                    BreakRemaining = tonumber(breakRemaining),
                    DropStartedAt = dropStartedAt
                }
            end
        end
    end

    return nil
end

local function findNearestDroppedEgg(eggName, previousUUIDs, dropPosition)
    local ActiveEggs = getActiveEggs()

    if not ActiveEggs or not dropPosition then
        return nil
    end

    local nearest = nil
    local nearestDistance = math.huge

    for _, egg in ipairs(ActiveEggs:GetChildren()) do
        local currentEggName = egg:GetAttribute("Egg")
        local uuid = getEggUUID(egg)
        local breakRemaining = tonumber(egg:GetAttribute("BreakRemaining"))
        local position = getEggPosition(egg)

        if currentEggName == eggName
            and uuid
            and position
            and breakRemaining ~= nil
            and not previousUUIDs[uuid] then

            local distance =
                (position - dropPosition).Magnitude

            if distance < nearestDistance then
                nearestDistance = distance

                nearest = {
                    Instance = egg,
                    UUID = tostring(uuid),
                    Egg = currentEggName,
                    BreakRemaining = breakRemaining,
                    DropStartedAt = egg:GetAttribute("DropStartedAt"),
                    Position = position,
                    Distance = distance
                }
            end
        end
    end

    return nearest
end

local function waitForDroppedEgg(eggName, previousUUIDs, dropPosition, timeout)
    timeout = timeout or 10

    local start = os.clock()

    while AutoPickupRunning
        and os.clock() - start < timeout do

        local data =
            findNearestDroppedEgg(
                eggName,
                previousUUIDs,
                dropPosition
            )

        if data then
            AddDebug(
                string.format(
                    "[AUTO] New dropped %s | UUID: %s | BreakRemaining: %.2f | Distance: %.1f",
                    tostring(data.Egg),
                    tostring(data.UUID),
                    data.BreakRemaining,
                    data.Distance
                )
            )

            return data
        end

        task.wait(0.1)
    end

    AddDebug(
        "[AUTO ERROR] New dropped egg not found"
    )

    return nil
end

local function sendArrivalClaim(uuid)
    if not EggArrivalClaimEvent then
        AddDebug(
            "[AUTO ERROR] EggArrivalClaim remote not found"
        )

        return false
    end

    local ranchCFrame =
        getMyRanchCFrame()

    if not ranchCFrame then
        AddDebug(
            "[AUTO ERROR] Cannot find ranch position for claim"
        )

        return false
    end

    local arrivalPosition =
        ranchCFrame.Position

    local serverTime

    pcall(function()
        serverTime =
            workspace:GetServerTimeNow()
    end)

    if not serverTime then
        serverTime =
            os.time()
    end

    local success, err =
        pcall(function()
            EggArrivalClaimEvent:FireServer(
                serverTime,
