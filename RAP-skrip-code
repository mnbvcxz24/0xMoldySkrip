RAPSkripFunctions.getDroppedEggData = function(uuid)
    local ActiveEggs=RAPSkripFunctions.getActiveEggs()

    if not ActiveEggs then
        RAPSkripFunctions.AddDebug("[AUTO ERROR] ActiveEggs not found")
        return nil
    end

    for _,egg in ipairs(ActiveEggs:GetChildren()) do
        local eggUUID=RAPSkripFunctions.getEggUUID(egg)

        if eggUUID and tostring(eggUUID)==tostring(uuid) then
            local eggName=egg:GetAttribute("Egg")
            local breakRemaining=egg:GetAttribute("BreakRemaining")
            local dropStartedAt=egg:GetAttribute("DropStartedAt")

            if breakRemaining~=nil then
                return {
                    Instance=egg,
                    UUID=tostring(eggUUID),
                    Egg=eggName,
                    BreakRemaining=tonumber(breakRemaining),
                    DropStartedAt=dropStartedAt
                }
            end
        end
    end

    return nil
end

RAPSkripFunctions.findNearestDroppedEgg = function(eggName,previousUUIDs,dropPosition)
    local ActiveEggs=RAPSkripFunctions.getActiveEggs()

    if not ActiveEggs or not dropPosition then
        return nil
    end

    local nearest=nil
    local nearestDistance=math.huge

    for _,egg in ipairs(ActiveEggs:GetChildren()) do
        local currentEggName=egg:GetAttribute("Egg")
        local uuid=RAPSkripFunctions.getEggUUID(egg)
        local breakRemaining=tonumber(egg:GetAttribute("BreakRemaining"))
        local position=RAPSkripFunctions.getEggPosition(egg)

        if currentEggName==eggName
            and uuid
            and position
            and breakRemaining~=nil
            and not previousUUIDs[tostring(uuid)] then

            local distance=(position-dropPosition).Magnitude

            if distance<nearestDistance then
                nearestDistance=distance

                nearest={
                    Instance=egg,
                    UUID=tostring(uuid),
                    Egg=currentEggName,
                    BreakRemaining=breakRemaining,
                    DropStartedAt=egg:GetAttribute("DropStartedAt"),
                    Position=position,
                    Distance=distance
                }
            end
        end
    end

    return nearest
end

waitForDroppedEgg=function(eggName,previousUUIDs,dropPosition,timeout)
    timeout=timeout or 10

    local start=os.clock()

    while AutoPickupRunning and os.clock()-start<timeout do
        local data=RAPSkripFunctions.findNearestDroppedEgg(
            eggName,
            previousUUIDs,
            dropPosition
        )

        if data then
            RAPSkripFunctions.AddDebug(string.format(
                tostring(data.Egg),
                tostring(data.UUID),
                tonumber(data.BreakRemaining) or 0,
                tonumber(data.Distance) or 0
            ))

            return data
        end

        task.wait(0.1)
    end

    RAPSkripFunctions.AddDebug("[AUTO ERROR] New dropped egg not found")
    return nil
end
