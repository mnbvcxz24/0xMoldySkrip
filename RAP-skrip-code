local CONFIG_FOLDER = "RAPSkrip"
local CONFIG_FILE = CONFIG_FOLDER .. "/rap_skrip_config.json"

local SelectedEggs = {}
local AutoSelectedEggs = {}
local AutoPlaceSelectedEggs = {}
local SelectedColorTheme = "Midnight"

local AutoPickupMovementMode = "Teleport"
local AutoPickupClaimDelay = 1.5

RAPSkripFunctions.saveConfig = function()
    if not writefile then
        RAPSkripFunctions.AddDebug("[CONFIG] writefile unavailable")
        return
    end

    local success, err = pcall(function()
        if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        end

        local selected = {}
        for eggName in pairs(SelectedEggs) do
            table.insert(selected, eggName)
        end
        table.sort(selected)

        local autoSelected = {}
        for eggName, enabled in pairs(AutoSelectedEggs) do
            if enabled then
                table.insert(autoSelected, eggName)
            end
        end
        table.sort(autoSelected)

        writefile(CONFIG_FILE, HttpService:JSONEncode({
            selectedEggs = selected,
            autoSelectedEggs = autoSelected,
            movementMode = AutoPickupMovementMode,
            claimDelay = AutoPickupClaimDelay,
            antiAFK = AntiAFKEnabled,
            colorTheme = SelectedColorTheme or "Midnight"
        }))

        RAPSkripFunctions.AddDebug("[CONFIG] Saved successfully")
    end)

    if not success then
        RAPSkripFunctions.AddDebug("[CONFIG ERROR] " .. tostring(err))
    end
end

RAPSkripFunctions.loadConfig = function()
    if not isfile or not readfile then
        RAPSkripFunctions.AddDebug("[CONFIG] File functions unavailable")
        return
    end

    local exists = false

    local checkSuccess = pcall(function()
        exists = isfile(CONFIG_FILE)
    end)

    if not checkSuccess or not exists then
        RAPSkripFunctions.AddDebug("[CONFIG] No saved config")
        return
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)

    if not success or type(data) ~= "table" then
        RAPSkripFunctions.AddDebug("[CONFIG] Invalid config")
        return
    end

    if type(data.selectedEggs) == "table" then
        for _, eggName in ipairs(data.selectedEggs) do
            if type(eggName) == "string" and eggName ~= "--" then
                SelectedEggs[eggName] = true
            end
        end
    end

    if type(data.autoSelectedEggs) == "table" then
        for _, eggName in ipairs(data.autoSelectedEggs) do
            if type(eggName) == "string" and eggName ~= "--" then
                AutoSelectedEggs[eggName] = true
            end
        end
    end

    if type(data.movementMode) == "string" then
        AutoPickupMovementMode = data.movementMode
    end

    if type(data.claimDelay) == "number" then
        AutoPickupClaimDelay = math.clamp(data.claimDelay, 1, 5)
    end

    if type(data.antiAFK) == "boolean" then
        AntiAFKEnabled = data.antiAFK
    end

    if type(data.colorTheme) == "string" then
        SelectedColorTheme = data.colorTheme
    end

    RAPSkripFunctions.AddDebug("[CONFIG] Loaded saved config")
end
RAPSkripFunctions.AddDebug("[SYSTEM] RAPSkrip initialized.")
RAPSkripFunctions.AddDebug("[SYSTEM] Version: "..tostring(ver))
RAPSkripFunctions.AddDebug("[SYSTEM] Ready.")
RAPSkripFunctions.loadConfig()
