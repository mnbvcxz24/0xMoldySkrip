    while AutoPickupRunning and os.clock()-start<timeout do
        if AutoPickupPickupConfirmed then
            return true
        end
        task.wait(0.1)
    end

    return false
end

RAPSkripFunctions.waitForDepositConfirmation = function()
    local timeout=8
