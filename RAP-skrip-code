local function tryAutoPickup(egg)
    if not AutoPickupRunning or AutoPickupBusy then return end

    if not egg then
        egg=findNextAutoPickupEgg()
    end

    if not egg then return end

    AutoPickupBusy=true

    local eggName=egg:GetAttribute("Egg")
    local eggPosition=getEggPosition(egg)
    local isVolcanic=eggName=="Volcanic Egg"
    local shouldAutoDip=(AutoDipEnabled==true and not isVolcanic)

    if not eggName or not eggPosition then
        AutoPickupBusy=false
        return
    end

    AddDebug("[AUTO] Pickup: "..tostring(eggName))

    if isVolcanic then
        enterVolcanicEgg(egg)
    else
        teleportToEgg(egg)
    end

    task.wait(AutoPickupClaimDelay)

    local pickupUUID=getEggUUID(egg)

    if not pickupUUID then
        AutoPickupBusy=false
        return
    end

    AutoPickupAwaitingUUID=tostring(pickupUUID)
    AutoPickupAwaitingPickup=true
    AutoPickupPickupConfirmed=false

    while AutoPickupRunning and not AutoPickupPickupConfirmed do
        EggPickupEvent:FireServer(tostring(pickupUUID))
        task.wait(0.1)
    end

    AutoPickupAwaitingPickup=false

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    stopAutoPickupFloat()

    if shouldAutoDip then
        local root=getCharacterRoot()

        if root then
            pcall(function()
                root.CFrame=CFrame.new(VolcanoDropPosition)
            end)
        end

        task.wait(0.5)

        AutoVolcanoMessageReceived=false
        AutoVolcanoMessageText=nil
        AutoVolcanoWaitingForMessage=true

        VolcanoDipEvent:FireServer()

        local mutationStart=os.clock()

        while AutoPickupRunning
            and not AutoVolcanoMessageReceived
            and os.clock()-mutationStart<15 do
            task.wait(0.1)
        end

        AutoVolcanoWaitingForMessage=false

        if not AutoVolcanoMessageReceived then
            AutoPickupBusy=false
            return
        end

        task.wait(3)

        stopAutoPickupFloat()

        local reachedOutside=false

        while AutoPickupRunning and not reachedOutside do
            if teleportOutsidePlot(eggPosition) then
                reachedOutside=true
                AddDebug("[AUTO DIP] TP -> Outside")
            else
                task.wait(0.1)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        task.wait(1)

    elseif isVolcanic then
        exitVolcanicEgg()
        stopAutoPickupFloat()

        local reachedOutside=false

        while AutoPickupRunning and not reachedOutside do
            if teleportOutsidePlot(eggPosition) then
                reachedOutside=true
            else
                task.wait(0.1)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        task.wait(1)

    else
        stopAutoPickupFloat()

        local reachedOutside=false

        while AutoPickupRunning and not reachedOutside do
            if teleportOutsidePlot(eggPosition) then
                reachedOutside=true
            else
                task.wait(0.1)
            end
        end

        if not AutoPickupRunning then
            AutoPickupBusy=false
            return
        end

        task.wait(1)
    end

    local BasketDropEvent=ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Game"):WaitForChild("BasketDrop")

    local previousDroppedUUIDs={}
    local activeEggsBeforeDrop=getActiveEggs()

    if activeEggsBeforeDrop then
        for _,existingEgg in ipairs(activeEggsBeforeDrop:GetChildren()) do
            local existingUUID=getEggUUID(existingEgg)

            if existingUUID then
                previousDroppedUUIDs[tostring(existingUUID)]=true
            end
        end
    end

    local root=getCharacterRoot()
    local dropPosition=root and root.Position

    if not dropPosition then
        AutoPickupBusy=false
        return
    end

    local droppedEgg=nil

    while AutoPickupRunning and not droppedEgg do
        BasketDropEvent:FireServer()

        droppedEgg=waitForDroppedEgg(
            eggName,
            previousDroppedUUIDs,
            dropPosition,
            2
        )

        if not droppedEgg then
            task.wait(0.1)
        end
    end

    if not AutoPickupRunning or not droppedEgg then
        AutoPickupBusy=false
        return
    end

    local droppedUUID=tostring(droppedEgg.UUID)

    AutoPickupAwaitingUUID=droppedUUID
    AutoPickupAwaitingPickup=true
    AutoPickupPickupConfirmed=false

    while AutoPickupRunning and not AutoPickupPickupConfirmed do
        EggPickupEvent:FireServer(droppedUUID)
        task.wait(0.1)
    end

    AutoPickupAwaitingPickup=false

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    local reachedPlot=false

    while AutoPickupRunning and not reachedPlot do
        if teleportToMyPlot() then
            reachedPlot=true
        else
            task.wait(0.1)
        end
    end

    if not AutoPickupRunning then
        AutoPickupBusy=false
        return
    end

    AutoPickupAwaitingDeposit=true
    AutoPickupDepositConfirmed=false

    while AutoPickupRunning and not AutoPickupDepositConfirmed do
        if EggArrivalClaimEvent then
            EggArrivalClaimEvent:FireServer(droppedUUID)
        end

        task.wait(0.1)
    end

    AutoPickupAwaitingDeposit=false

    if AutoPickupDepositConfirmed then
        AddDebug("[AUTO] Egg deposited successfully")
    end

    AutoPickupAwaitingUUID=nil
    AutoPickupBusy=false
end
