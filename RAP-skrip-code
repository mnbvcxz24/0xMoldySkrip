local function updateClaimDelayFromX(x)
    local width = AutoClaimBar.AbsoluteSize.X
    if width <= 0 then
        return
    end

    local relative = math.clamp((x - AutoClaimBar.AbsolutePosition.X) / width, 0, 1)
    AutoPickupClaimDelay = math.floor((1 + relative * 4) * 10 + 0.5) / 10

    local alpha = (AutoPickupClaimDelay - 1) / 4
    AutoClaimFill.Size = UDim2.new(alpha, 0, 1, 0)
    AutoClaimKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
    AutoClaimLabel.Text = string.format("Claim Delay: %.1fs", AutoPickupClaimDelay)
end

