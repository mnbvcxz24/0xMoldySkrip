-- True only when the character root is inside the player's own plot Baseplate.
-- Use the Baseplate's local space so rotated plots are handled correctly.
RAPSkripFunctions.isCharacterInMyPlot = function()
    local plot = RAPSkripFunctions.findMyPlot()
    local root = RAPSkripFunctions.getCharacterRoot()
    local baseplate = plot and plot:FindFirstChild("Baseplate")

    if not root or not baseplate or not baseplate:IsA("BasePart") then
        return false
    end

    local localPosition = baseplate.CFrame:PointToObjectSpace(root.Position)
    local halfSize = baseplate.Size * 0.5
    local margin = 8

    return math.abs(localPosition.X) <= halfSize.X + margin
        and math.abs(localPosition.Z) <= halfSize.Z + margin
        and localPosition.Y >= -halfSize.Y - 12
        and localPosition.Y <= halfSize.Y + 80
end

