local function startAutoPickupFloat(position)
    local character = player.Character

    if not character then
        return false
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return false
    end

    local attachment =
        root:FindFirstChild(
            "AutoPickupFloatAttachment"
        )

    if not attachment then
        attachment =
            Instance.new("Attachment")

        attachment.Name =
            "AutoPickupFloatAttachment"

        attachment.Parent = root
    end

    local force =
        root:FindFirstChild(
            "AutoPickupFloatForce"
        )

    if not force then
        force =
            Instance.new("VectorForce")

        force.Name =
            "AutoPickupFloatForce"

        force.Attachment0 =
            attachment

        force.RelativeTo =
            Enum.ActuatorRelativeTo.World

        force.ApplyAtCenterOfMass =
            true

        force.Parent = root
    end

    AutoPickupFloating = true
    AutoPickupFloatForce = force

    root.CFrame =
        CFrame.new(
            position +
            Vector3.new(
                0,
                AutoPickupFloatHeight,
                0
            )
        )

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    force.Force =
        Vector3.new(
            0,
            root.AssemblyMass *
                workspace.Gravity,
            0
        )

    return true
end

local function stopAutoPickupFloat()
    AutoPickupFloating = false

    local force =
        AutoPickupFloatForce

    AutoPickupFloatForce = nil

    if force then
        pcall(function()
            force:Destroy()
        end)
    end

    local character =
        player.Character

    if not character then
        return
    end

    local root =
