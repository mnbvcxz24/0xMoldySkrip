RAPSkripFunctions.getActiveEggs = function()
    local ServerData =
        ReplicatedStorage:FindFirstChild("ServerData")

    if not ServerData then
        return nil
    end

    return ServerData:FindFirstChild("ActiveEggs")
end

RAPSkripFunctions.getEggPosition = function(egg)
    if not egg then
        return nil
    end

    local position =
        egg:GetAttribute("Position")

    if typeof(position) == "Vector3" then
        return position
    end

    if typeof(position) == "CFrame" then
        return position.Position
    end

    local primaryPart =
        egg:IsA("Model") and egg.PrimaryPart

    if primaryPart then
        return primaryPart.Position
    end

    if egg:IsA("BasePart") then
        return egg.Position
    end

    local part =
        egg:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil
end

RAPSkripFunctions.getEggUUID = function(egg)
    if not egg then
        return nil
    end

    local uuid =
        egg:GetAttribute("UUID")

    if uuid == nil then
        uuid =
            egg:GetAttribute("Uuid")
    end

    if uuid == nil then
        uuid =
            egg:GetAttribute("Id")
    end

    if uuid == nil then
        uuid =
            egg:GetAttribute("ID")
    end

    if uuid == nil then
        uuid = egg.Name
    end

    if typeof(uuid) ~= "string" then
        uuid = tostring(uuid)
    end

    if uuid == "" then
        return nil
    end

    return uuid
end

